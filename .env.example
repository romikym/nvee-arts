# Copy this file to .env (and never commit .env).
# Get your test key from https://dashboard.stripe.com/test/apikeys

# Use sk_test_... for development. Switch to sk_live_... when you're ready
# to take real money (after activating your Stripe account).
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Optional: the public URL of your site. Netlify sets this automatically
# in production; only needed for local testing.
URL=http://localhost:8888
